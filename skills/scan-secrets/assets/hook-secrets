#!/bin/sh
# Pose, retire et inspecte le hook de scan de secrets, dépôt par dépôt.
#
#   hook-secrets etat [racine]      qui l'a, qui ne l'a pas (défaut : dossier courant)
#   hook-secrets poser <dépôt>...   installe sur ces dépôts
#   hook-secrets retirer <dépôt>... désinstalle
#
# Le hook posé est un lanceur de trois lignes qui appelle le hook central du skill :
# corriger le central corrige tous les dépôts d'un coup, sans réinstallation.

CENTRAL="$HOME/.claude/skills/scan-secrets/assets/pre-commit"
MARQUE="# scan-secrets:lanceur"

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

est_depot() { [ -d "$1/.git" ] || git -C "$1" rev-parse --git-dir >/dev/null 2>&1; }

poser() {
  d="$1"
  est_depot "$d" || { echo "  ✗ $d — pas un dépôt Git"; return 1; }
  hooks="$(git -C "$d" rev-parse --absolute-git-dir)/hooks"
  mkdir -p "$hooks"
  cible="$hooks/pre-commit"

  if [ -f "$cible" ] && ! grep -q "$MARQUE" "$cible" 2>/dev/null; then
    # Un hook étranger existe : on ne l'écrase jamais en silence.
    sauvegarde="$cible.avant-scan-secrets"
    if [ -e "$sauvegarde" ]; then
      echo "  ✗ $d — un hook existe déjà ET une sauvegarde aussi. Range-les à la main."
      return 1
    fi
    mv "$cible" "$sauvegarde"
    echo "  ⚠ $d — hook existant déplacé vers $(basename "$sauvegarde")"
  fi

  cat > "$cible" <<LANCEUR
#!/bin/sh
$MARQUE
CENTRAL="$CENTRAL"
[ -x "\$CENTRAL" ] || { echo "❌ SÉCURITÉ : hook central introuvable (\$CENTRAL). Commit bloqué."; exit 1; }
exec "\$CENTRAL"
LANCEUR
  chmod +x "$cible"
  echo "  ✓ $d"
}

retirer() {
  d="$1"
  est_depot "$d" || { echo "  ✗ $d — pas un dépôt Git"; return 1; }
  cible="$(git -C "$d" rev-parse --absolute-git-dir)/hooks/pre-commit"
  if [ ! -f "$cible" ]; then echo "  · $d — rien à retirer"; return 0; fi
  if ! grep -q "$MARQUE" "$cible" 2>/dev/null; then
    echo "  ✗ $d — le hook présent n'est pas le nôtre, je n'y touche pas"; return 1
  fi
  rm -f "$cible"
  if [ -f "$cible.avant-scan-secrets" ]; then
    mv "$cible.avant-scan-secrets" "$cible"
    echo "  ✓ $d — retiré, hook précédent restauré"
  else
    echo "  ✓ $d — retiré"
  fi
}

etat() {
  racine="${1:-.}"
  printf '%-52s %-10s %s\n' "DÉPÔT" "HOOK" "REMOTE"
  find "$racine" -maxdepth 4 -name .git -not -path "*/node_modules/*" 2>/dev/null | while read -r g; do
    d="$(dirname "$g")"
    cible="$g/hooks/pre-commit"
    if [ -f "$cible" ] && grep -q "$MARQUE" "$cible" 2>/dev/null; then h="posé"
    elif [ -f "$cible" ]; then h="autre"
    else h="—"; fi
    r="$(git -C "$d" remote get-url origin 2>/dev/null)"
    printf '%-52s %-10s %s\n' "${d#./}" "$h" "${r:-local}"
  done
}

[ -x "$CENTRAL" ] || { echo "hook central introuvable : $CENTRAL"; exit 1; }

action="$1"; [ $# -gt 0 ] && shift
case "$action" in
  etat|"")        etat "$1" ;;
  poser)          [ $# -gt 0 ] || usage; for d in "$@"; do poser "$d"; done ;;
  retirer)        [ $# -gt 0 ] || usage; for d in "$@"; do retirer "$d"; done ;;
  *)              usage ;;
esac
